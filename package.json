    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@rspress/core": "^2.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
